generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")

  certificateIssuedAt DateTime?

  paroki    String?
  wilayah   String?

  createdAt DateTime @default(now())

  progress  UserProgress[]

  roomsAsUser   ChatRoom[] @relation("UserRooms")
  roomsAsPastor ChatRoom[] @relation("PastorRooms")
}

model UserProgress {
  id Int @id @default(autoincrement())

  userId String   

  moduleSlug String
  lessonSlug String

  completed Boolean @default(false)

  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleSlug, lessonSlug])
}


model ChatRoom {
  id        String   @id @default(cuid())

  userId    String
  pastorId  String

  user      User     @relation("UserRooms", fields: [userId], references: [id])
  pastor    User     @relation("PastorRooms", fields: [pastorId], references: [id])

  messages  Message[]

  lastMessage String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())

  roomId    String
  senderId  String
  text      String

  room      ChatRoom @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
}
